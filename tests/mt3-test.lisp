     ("C7alt" :jazz '((3 . "E") (7 . "Bb") (9 . "Db")) '((3 . "E") (7 . "Bb") (9 . "Db") (9 . "D#")))
     ("C13#11" :pop '((3 . "E") (7 . "Bb") (13 . "A")) '((3 . "E") (7 . "Bb") (13 . "A") (11 . "F#")))
     ("C13b9" :pop '((3 . "E") (7 . "Bb") (13 . "A")) '((3 . "E") (7 . "Bb") (13 . "A") (9 . "Db")))
