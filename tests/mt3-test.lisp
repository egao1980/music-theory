(deftest every-quality-word-reads
  ;; Every word of every dialect after the root C reads as its row says.
  (let* ((cases (loop for d in *dialects* nconc (mapcar (lambda (w) (cons d w)) (dialect-words d))))
         (bad (collect-mismatches (case cases)
                (destructuring-bind (d word quality extensions added) case
                  (same-chord-p (ch :root "C" :quality quality :extensions extensions :added added)
                                (cp (concatenate 'string "C" word) d))))))
    (ok (= 159 (length (dialect-words :pop))))
    (ok (null bad) (report bad))))

;;; Unknown qualities ----------------------------------------------------------

(deftest unknown-chord-quality-warning
  (let ((seen nil))
    (let ((c (handler-bind ((unknown-chord-quality
                              (lambda (w) (setf seen (unknown-chord-quality-text w)) (muffle-warning w))))
               (cp "Cdom7(b9)"))))
      (ok (equal "dom7" seen))
      (ok (same-chord-p (ch :root "C" :quality :major :alterations '((9 . -1))) c) "falls back to :major")))
  (ok (same-chord-p (ch :root "C" :quality :dominant-7 :alterations '((9 . -1)))
                    (handler-bind ((unknown-chord-quality (lambda (w) (use-value :dominant-7 w))))
                      (cp "Cdom7(b9)")))
      "USE-VALUE supplies the quality")
  (ok (same-chord-p (ch :root "C" :quality :major :bass "E") (quietly (lambda () (cp "Cfoo/E")))))
  (ok (equal "h7" (handler-case (cp "Ch7") (unknown-chord-quality (w) (unknown-chord-quality-text w)))))
  (ok (typep (handler-case (cp "Cfoo") (warning (w) w)) 'music-theory-warning))
  (ok (null (handler-case (progn (quietly (lambda () (cp "Cfoo"))) nil) (error (e) e)))
      "a warning, not an error")
  (ok (signals-type (lambda ()
                      (handler-bind ((unknown-chord-quality (lambda (w) (use-value :baroque w))))
                        (cp "Cfoo")))
                    'type-error)
      "USE-VALUE takes a quality of +chord-qualities+")
  (ok (typep (parse-failure "Cmajor") 'chord-symbol-parse-error) "a known word, then junk: an error")
  (ok (search "dom7" (princ-to-string (make-condition 'unknown-chord-quality :text "dom7")))))

