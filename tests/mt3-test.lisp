  (let ((c (parse-failure "C7(b9")))
    (ok (search "C7(b9" (princ-to-string c)))
    (ok (search "at 5" (princ-to-string c))))
  (ok (signals-type (lambda () (call #'parse-chord-symbol "C" :dialect :baroque)) 'type-error))
  (ok (signals-type (lambda () (call #'parse-chord-symbol 'c7)) 'type-error)))

