     ("C7b5" :pop '((3 . "E") (7 . "Bb") (5 . "Gb")) '((3 . "E") (7 . "Bb") (5 . "Gb") (1 . "C")))
     ("C7#5#9" :pop '((3 . "E") (7 . "Bb") (5 . "G#")) '((3 . "E") (7 . "Bb") (5 . "G#") (9 . "D#")))
     ("C7sus4" :pop '((4 . "F") (7 . "Bb") (1 . "C")) '((4 . "F") (7 . "Bb") (1 . "C") (5 . "G")))
     ("C9sus4" :pop '((4 . "F") (7 . "Bb") (9 . "D")) '((4 . "F") (7 . "Bb") (9 . "D") (1 . "C")))
     ("Csus2" :pop '((1 . "C") (2 . "D") (5 . "G")) '((1 . "C") (2 . "D") (5 . "G")))
     ("Cadd9" :pop '((1 . "C") (3 . "E") (9 . "D")) '((1 . "C") (3 . "E") (9 . "D") (5 . "G")))
     ("C6/9" :pop '((3 . "E") (6 . "A") (9 . "D")) '((3 . "E") (6 . "A") (9 . "D") (1 . "C")))
     ("Cm6/9" :pop '((3 . "Eb") (6 . "A") (9 . "D")) '((3 . "Eb") (6 . "A") (9 . "D") (1 . "C")))
     ("Cmaj7#11" :pop '((3 . "E") (7 . "B") (11 . "F#")) '((3 . "E") (7 . "B") (11 . "F#") (1 . "C")))
     ("C7(13)" :pop '((3 . "E") (7 . "Bb") (13 . "A")) '((3 . "E") (7 . "Bb") (13 . "A") (1 . "C")))
     ("C13(no9)" :pop '((3 . "E") (7 . "Bb") (13 . "A")) '((3 . "E") (7 . "Bb") (13 . "A") (1 . "C")))
     ("C11(omit3)" :pop '((11 . "F") (7 . "Bb") (1 . "C")) '((11 . "F") (7 . "Bb") (1 . "C") (9 . "D")))
     ("C(omit3)" :pop '((1 . "C") (5 . "G")) '((1 . "C") (5 . "G")))
     ("C7(omit3)" :pop '((7 . "Bb") (1 . "C") (5 . "G")) '((7 . "Bb") (1 . "C") (5 . "G")))
     ("C5" :pop '((1 . "C") (5 . "G")) '((1 . "C") (5 . "G")))
     ("C5(add9)" :pop '((1 . "C") (9 . "D") (5 . "G")) '((1 . "C") (9 . "D") (5 . "G")))
     ("C5(add#4,addb6,omit5)" :pop '((1 . "C") (4 . "F#") (6 . "Ab")) '((1 . "C") (4 . "F#") (6 . "Ab")))
     ("Cdim" :classical '((1 . "C") (3 . "Eb") (5 . "Gb")) '((1 . "C") (3 . "Eb") (5 . "Gb")))
     ("C+" :pop '((1 . "C") (3 . "E") (5 . "G#")) '((1 . "C") (3 . "E") (5 . "G#")))
     ("G7/B" :pop '((3 . "B") (7 . "F") (1 . "G")) '((3 . "B") (7 . "F") (1 . "G") (5 . "D")))
     ("F#m7b5" :pop '((3 . "A") (7 . "E") (5 . "C")) '((3 . "A") (7 . "E") (5 . "C") (1 . "F#"))))
  (let ((c (cp text dialect)))
    (ok (equal three (tone-names (chord-essential-tones c 3))))
    (ok (equal four (tone-names (chord-essential-tones c 4))))))

(deftest chord-essential-tones-edges
  (ok (null (chord-essential-tones (cp "C13") 0)))
  (ok (equal '((3 . "E") (7 . "Bb") (13 . "A") (1 . "C") (9 . "D") (5 . "G"))
             (tone-names (chord-essential-tones (cp "C13") 10)))
      "never more than the row: the 11 of C13 is left out")
  (ok (equal '((3 . "E") (7 . "Bb") (9 . "Db") (9 . "D#") (11 . "F#") (13 . "Ab") (1 . "C"))
             (tone-names (chord-essential-tones (cp "C7alt" :jazz) 7))))
  (ok (null (chord-essential-tones (cp "N.C.") 3)))
  (ok (signals-type (lambda () (call #'chord-essential-tones (cp "C7") -1)) 'type-error))
  (ok (signals-type (lambda () (call #'chord-essential-tones (cp "C7") 2.5)) 'type-error)))

(deftest chord-essential-tones-properties
  ;; Over every fixture chord: the result is a prefix of the next n, a subset of
  ;; the chord's tones, and free of repeats.
  (let ((bad (collect-mismatches (case (symbol-fixture-cases))
               (destructuring-bind ((text &rest more) d) case
                 (declare (ignore more))
                 (let* ((c (cp text d))
                        (tones (tone-names (chord-tones c)))
                        (all (tone-names (chord-essential-tones c 8))))
                   (and (every (lambda (p) (member p tones :test #'equal)) all)
                        (= (length all) (length (remove-duplicates all :test #'equal)))
                        (loop for n from 0 to 8
                              always (equal (subseq all 0 (min n (length all)))
                                            (tone-names (chord-essential-tones c n))))))))))
    (ok (null bad) (report bad))))

;;; Transposition --------------------------------------------------------------

(deftest-parametrize transpose-by-interval
    ((text interval expected)
     ("G7/B" "m2" "Ab7/C")
     ("G7/B" "A1" "G#7/B#")
     ("G7/B" "-M2" "F7/A")
     ("C" "P8" "C")
     ("C" "P12" "G")
     ("F#m7b5" "M2" "G#m7(b5)")
     ("Bb6/9" "P5" "F6/9")
     ("C/F#" "d5" "Gb/C")
     ("Eb7#9" "-m3" "C7(#9)")
     ("Db+M7" "A4" "G+maj7")
     ("C7alt" "M2" "D7(b9,#9,#11,b13,omit5)")
     ("E#" "A1" "E##")
     ("N.C." "M2" "N.C."))
  (ok (string= expected (print-chord-symbol (transpose-chord-symbol (cp text) (parse-interval interval))
                                            :dialect :pop))))

(deftest-parametrize transpose-by-keys
    ((text from to expected)
     ("G7/B" "C major" "Db major" "Ab7/C")
     ("G7/B" "C major" "C# major" "G#7/B#")
     ("G7/B" "C major" "Cb major" "Gb7/Bb")
     ("Dm7" "C major" "F# major" "G#m7")
     ("F#dim7" "C major" "Eb major" "Adim7")
     ("Bm7b5" "A minor" "Bb minor" "Cm7(b5)")
     ("E7" "A minor" "C major" "G7")
     ("C7" "C major" "C major" "C7"))
  (ok (string= expected (print-chord-symbol (transpose-chord-symbol (cp text) (list (k from) (k to)))
                                            :dialect :pop))))

(deftest transpose-chord-symbol-rules
  (let* ((c (cp "Cm7b5(b9)/Gb" :jazz))
         (moved (transpose-chord-symbol c (parse-interval "M3"))))
    (ok (null (chord-symbol-text moved)) "TEXT is NIL")
    (ok (eq :jazz (chord-symbol-dialect moved)) "DIALECT is kept")
    (ok (same-chord-p (ch :root "E" :quality :half-diminished-7 :alterations '((9 . -1)) :bass "Bb") moved)))
  (let ((nc (transpose-chord-symbol (cp "N.C." :jazz) (parse-interval "M2"))))
    (ok (same-chord-p (ch :no-chord-p t) nc))
    (ok (null (chord-symbol-text nc)))
    (ok (eq :jazz (chord-symbol-dialect nc))))
  (ok (signals-type (lambda () (transpose-chord-symbol (cp "B##") (parse-interval "A1"))) 'invalid-pitch)
      "the root needs three sharps")
  (ok (signals-type (lambda () (transpose-chord-symbol (cp "C/B##") (parse-interval "A1"))) 'invalid-pitch)
      "the bass needs three sharps")
  (let ((moved (transpose-chord-symbol (cp "E#") (parse-interval "A1"))))
    (ok (equalp (pc "E##") (chord-symbol-root moved)) "transposing never spells the tones")
    (ok (signals-type (lambda () (chord-tones moved)) 'invalid-pitch)))
  (dolist (bad (list (list (k "C major")) "M2" :up (list (k "C major") (k "D major") (k "E major"))
                     (list (parse-interval "M2") (k "C major"))))
    (ok (signals-type (lambda () (call #'transpose-chord-symbol (cp "C7") bad)) 'type-error)
        (prin1-to-string bad))))

(deftest transpose-there-and-back
  ;; Every fixture chord up and back down by eight intervals (rows whose root or
  ;; bass would leave two accidentals are skipped).
  (let* ((intervals (mapcar #'parse-interval '("M2" "m3" "A4" "d5" "P5" "m6" "-m2" "A1")))
         (bad (collect-mismatches (case (symbol-fixture-cases))
                (destructuring-bind ((text &rest more) d) case
                  (declare (ignore more))
                  (let ((c (cp text d)))
                    (every (lambda (i)
                             (let ((up (handler-case (transpose-chord-symbol c i) (invalid-pitch () nil))))
                               (or (null up)
                                   (same-chord-p c (transpose-chord-symbol up (reverse-interval i))))))
                           intervals))))))
    (ok (null bad) (report bad))))

;;; Well-formedness ------------------------------------------------------------

(deftest malformed-chord-symbols
  (dolist (c (list (ch :root "C" :quality :major :extensions '(9))
                   (ch :root "C" :quality :dominant-7 :extensions '(11))
                   (ch :root "C" :quality :dominant-7 :extensions '(9 13))
                   (ch :root "C" :quality :minor-7 :alterations '((5 . -1)))
                   (ch :root "C" :quality :major :alterations '((5 . 1)))
                   (ch :root "C" :quality :dominant-7 :alterations '((9 . 1) (9 . -1)))
                   (ch :root "C" :quality :dominant-7 :alterations '((9 . -1) (9 . -1)))
                   (ch :root "C" :quality :dominant-7 :alterations '((11 . -1)))
                   (ch :root "C" :quality :augmented :alterations '((5 . -1)))
                   (ch :root "C" :quality :minor :suspension 4)
                   (ch :root "C" :quality :major :suspension 4 :omitted '(3))
                   (ch :root "C" :quality :major :added '((9 . 1)))
                   (ch :root "C" :quality :major :added '((3 . 0)))
                   (ch :root "C" :quality :major :added '((9 . 0) (9 . 0)))
                   (ch :root "C" :quality :major-6 :added '((6 . 0)))
                   (ch :root "C" :quality :dominant-7 :extensions '(9) :added '((9 . 0)))
                   (ch :root "C" :quality :dominant-7 :alterations '((9 . -1)) :added '((9 . 0)))
                   (ch :root "C" :quality :major :omitted '(7))
                   (ch :root "C" :quality :major :omitted '(9))
                   (ch :root "C" :quality :major :omitted '(5 3))
                   (ch :root "C" :quality :dominant-7 :alterations '((5 . -1)) :omitted '(5))
                   (ch :root "C" :quality :power :omitted '(3))
                   (ch :root "C" :quality :pedal)
                   (ch :quality :major)
                   (ch :root "C")
                   (ch :no-chord-p t :root "C")
                   (ch :no-chord-p t :omitted '(5))))
    (ok (signals-with-text (lambda () (print-chord-symbol c)) 'music-theory-error nil) (prin1-to-string c))
    (ok (signals-with-text (lambda () (chord-tones c)) 'music-theory-error nil))
    (ok (signals-with-text (lambda () (chord-essential-tones c 3)) 'music-theory-error nil))
    (ok (signals-with-text (lambda () (transpose-chord-symbol c (parse-interval "M2")))
                           'music-theory-error nil)))
  (ok (signals-type (lambda () (call #'chord-tones "C7")) 'type-error))
  (ok (signals-type (lambda () (call #'print-chord-symbol nil)) 'type-error)))

(deftest chord-for-values-are-well-formed
  ;; MT2's CHORD-FOR sets ROOT, QUALITY and BASS only: MT3 prints and realises them.
  (let ((c-major (k "C major")))
    (ok (string= "D7" (print-chord-symbol (chord-for (r "V7/V") c-major))))
    (ok (string= "F#dim7" (print-chord-symbol (chord-for (r "viio7/V") c-major))))
    (ok (string= "G7/B" (print-chord-symbol (chord-for (r "V65") c-major))))
    (ok (string= "Dm7(b5)" (print-chord-symbol (chord-for (r "ii/o7") c-major))))
    (ok (string= "Dø7" (print-chord-symbol (chord-for (r "ii/o7") c-major) :dialect :jazz)))
    (ok (string= "Bm(b5)" (print-chord-symbol (chord-for (r "viio") c-major))))
    (ok (string= "B°" (print-chord-symbol (chord-for (r "viio") c-major) :dialect :classical)))
    (ok (equal '((1 . "Ab") (3 . "C") (5 . "Eb")) (tone-names (chord-tones (chord-for (r "bVI") c-major)))))
    (ok (equalp (r "V65") (roman-for (cp "G7/B") c-major)))
    (ok (equalp (r "vii/o7") (roman-for (cp "Bm7b5") c-major)))
    (ok (equalp (r "viio") (roman-for (cp "Bdim" :classical) c-major)))
    (ok (equalp (r "viio7") (roman-for (cp "Bdim" :pop) c-major)))
    (ok (equalp (r "iv") (roman-for (cp "Fm") c-major)))
    (ok (equalp (r "bVII") (roman-for (cp "Bb") c-major)))
    (ok (signals-type (lambda () (roman-for (cp "C7b9") c-major)) 'music-theory-error)
        "a Roman numeral has no altered tones")))

(deftest mt3-values-are-readable
  (let ((*package* (find-package '#:music-theory/tests)))
    (dolist (text '("C" "Cm7b5(b9)/Gb" "C7alt" "N.C." "C6/9/E" "C5(#9,add#4,add#6,omit5)"))
      (let ((c (cp text :jazz)))
        (ok (equalp c (read-from-string (prin1-to-string c))) text)))))
