  (ok (null (handler-bind ((chord-symbol-parse-error #'skip-chord-symbol)) (cp "C7(b9")))
      "SKIP-CHORD-SYMBOL returns NIL")
  (ok (equal '("C" nil "G7")
             (handler-bind ((chord-symbol-parse-error #'skip-chord-symbol))
               (mapcar (lambda (s) (let ((c (cp s))) (and c (print-chord-symbol c))))
                       '("C" "C/H" "G7"))))
      "a lead sheet skips what it cannot read")
  (ok (let (found)
        (handler-bind ((chord-symbol-parse-error
                         (lambda (c)
                           (setf found (and (find-restart 'use-value c) (find-restart 'skip-chord-symbol c) t))
                           (skip-chord-symbol c))))
          (cp "C/H"))
        found)
