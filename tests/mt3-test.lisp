;;;; MT3: chord-symbol grammar, dialects, realisation, essential tones, transposition.
;;;; Fixture vectors come from music21 10.5.2 (tests/fixtures/PROVENANCE.md): each
;;;; row's chord is named by a music21 recipe, so the realised tones are music21's.
;;;; Hand-written rows follow the rules in src/chord-symbol.lisp and
;;;; src/chord-tones.lisp. They were cross-checked against an independent
;;;; reference implementation of those rules (no mismatches), and the tones of
;;;; every fixture row against music21.
;;;; Uses PC, K, R, CALL and SIGNALS-TYPE from mt2-test.lisp.

(in-package #:music-theory/tests)

(defparameter *dialects* '(:classical :pop :jazz))

(defun cp (text &optional (dialect :pop))
  (parse-chord-symbol text :dialect dialect))

(defun ch (&key root quality extensions alterations suspension added omitted bass no-chord-p)
  "A CHORD-SYMBOL from strings for ROOT and BASS."
  (make-chord-symbol :root (and root (pc root)) :quality quality :extensions extensions
                     :alterations alterations :suspension suspension :added added
                     :omitted omitted :bass (and bass (pc bass)) :no-chord-p no-chord-p))

(defun same-chord-p (a b)
  "True when A and B agree in every slot but TEXT and DIALECT."
  (and (chord-symbol-p a) (chord-symbol-p b)
       (equalp (chord-symbol-root a) (chord-symbol-root b))
       (eq (chord-symbol-quality a) (chord-symbol-quality b))
       (equal (chord-symbol-extensions a) (chord-symbol-extensions b))
       (equal (chord-symbol-alterations a) (chord-symbol-alterations b))
       (eql (chord-symbol-suspension a) (chord-symbol-suspension b))
       (equal (chord-symbol-added a) (chord-symbol-added b))
       (equal (chord-symbol-omitted a) (chord-symbol-omitted b))
       (equalp (chord-symbol-bass a) (chord-symbol-bass b))
       (eq (chord-symbol-no-chord-p a) (chord-symbol-no-chord-p b))))

(defun tone-names (pairs)
  "((degree . PITCH-CLASS-NAME) ...) → ((degree . \"name\") ...)."
  (mapcar (lambda (p) (cons (car p) (pitch-class-string (cdr p)))) pairs))

(defun same-set-p (a b)
  (null (set-exclusive-or a b :test #'string=)))

(defun class-names (pairs)
  (remove-duplicates (mapcar (lambda (p) (pitch-class-string (cdr p))) pairs) :test #'string=))

(defun parse-failure (text &optional (dialect :pop))
  "The CHORD-SYMBOL-PARSE-ERROR that parsing TEXT signals, or NIL."
  (handler-case (progn (parse-chord-symbol text :dialect dialect) nil)
    (chord-symbol-parse-error (c) c)))

(defun quietly (thunk)
  "Call THUNK with UNKNOWN-CHORD-QUALITY warnings muffled."
  (handler-bind ((unknown-chord-quality #'muffle-warning)) (funcall thunk)))

(defun symbol-fixture-cases ()
  "(row dialect) for every mt3-symbols.sexp row and each dialect it applies to."
  (loop for row in (fixture "mt3-symbols.sexp")
        nconc (loop for d in (if (second row) (list (second row)) *dialects*)
                    collect (list row d))))

(defun seventh-quality-p (quality)
  (and (assoc quality music-theory::+chord-seventh-stems+) t))

(defun quality-degrees (quality)
  (mapcar (lambda (name) (interval-number (parse-interval name)))
          (third (assoc quality music-theory::+chord-qualities+))))

(defun dialect-words (dialect)
  "(word quality extensions added) for every quality word DIALECT reads."
  (append
   (loop for (word quality . plist) in music-theory::+chord-quality-words+
         for dialects = (getf plist :dialects)
         when (or (null dialects) (member dialect dialects))
           collect (list word quality (getf plist :extensions) (getf plist :added)))
   (loop for (quality . stems) in music-theory::+chord-seventh-stems+
         nconc (loop for stem in stems
                     nconc (loop for (number . extensions) in music-theory::+chord-extension-numbers+
                                 collect (list (concatenate 'string stem number) quality extensions nil))))))

(defparameter *musicxml-kinds*
  '("major" "minor" "augmented" "diminished" "dominant" "major-seventh" "minor-seventh"
    "diminished-seventh" "augmented-seventh" "half-diminished" "major-minor" "major-sixth"
    "minor-sixth" "dominant-ninth" "major-ninth" "minor-ninth" "dominant-11th" "major-11th"
    "minor-11th" "dominant-13th" "major-13th" "minor-13th" "suspended-second"
    "suspended-fourth" "Neapolitan" "Italian" "French" "German" "pedal" "power" "Tristan"
    "other" "none")
  "The 33 <kind> values of MusicXML 4.0 (kind-value).")

;;; Data (these pass before the MT3 functions exist) -------------------------

(deftest chord-word-tables
  (let ((qualities (mapcar #'first music-theory::+chord-qualities+)))
    (ok (every (lambda (row)
                 (destructuring-bind (word quality &key extensions added dialects) row
                   (and (stringp word) (member quality qualities)
                        (member extensions '(() (9) (9 11) (9 11 13)) :test #'equal)
                        (every (lambda (p) (member (car p) '(2 4 6 9 11 13))) added)
                        (subsetp dialects *dialects*))))
               music-theory::+chord-quality-words+))
    (ok (equal (mapcar #'first music-theory::+chord-seventh-stems+)
               '(:dominant-7 :major-7 :minor-7 :minor-major-7 :half-diminished-7
                 :diminished-7 :augmented-7 :augmented-major-7)))
    (ok (equal (subseq qualities 4 12) (mapcar #'first music-theory::+chord-seventh-stems+))
        "the seventh qualities of +chord-qualities+")
    (ok (equal '(("7") ("9" 9) ("11" 9 11) ("13" 9 11 13)) music-theory::+chord-extension-numbers+)))
  (dolist (d *dialects*)
    (let ((words (mapcar #'first (dialect-words d))))
      (ok (= (length words) (length (remove-duplicates words :test #'string=)))
          (format nil "each ~A word has one meaning" d))))
  (ok (equal '(:diminished :diminished-7 :diminished-7)
             (mapcar (lambda (d) (second (find "dim" (dialect-words d) :key #'first :test #'string=)))
                     *dialects*))
      "dim is a triad in classical, a seventh in pop and jazz")
  (ok (every (lambda (w) (equal (find w (dialect-words :classical) :key #'first :test #'string=)
                                (find w (dialect-words :pop) :key #'first :test #'string=)))
             (set-difference (mapcar #'first (dialect-words :classical)) '("dim" "o" "°")
                             :test #'string=))
      "the dialects read every other word alike"))

(deftest chord-quality-fact-tables
  (let ((rows music-theory::+chord-qualities+))
    (flet ((intervals (q) (third (assoc q rows))))
      (ok (equal music-theory::+perfect-fifth-qualities+
                 (loop for (q nil iv) in rows when (member "P5" iv :test #'string=) collect q)))
      (ok (equal music-theory::+suspendable-qualities+
                 (loop for (q nil iv) in rows when (string= "M3" (first iv)) collect q)))
      (ok (every (lambda (row)
                   (destructuring-bind (from (degree . alter) to) row
                     (and (= degree 5)
                          (member from music-theory::+perfect-fifth-qualities+)
                          (equal (intervals to)
                                 (substitute (if (= alter 1) "A5" "d5") "P5" (intervals from)
                                             :test #'string=)))))
                 music-theory::+fifth-alteration-folds+)
          "a fold is the same chord with its fifth altered"))
    (ok (equal music-theory::+chord-alterations+
               '((5 . -1) (5 . 1) (9 . -1) (9 . 1) (11 . 1) (13 . -1))))
    (ok (subsetp music-theory::+altered-dominant+ music-theory::+chord-alterations+ :test #'equal))
    (ok (every (lambda (row) (= (car row) (interval-number (parse-interval (cdr row)))))
               music-theory::+chord-degree-intervals+))
    (ok (equal music-theory::+no-chord-words+ '("N.C." "N.C" "NC")))))

(deftest chord-print-tables
  (let ((qualities (mapcar #'first music-theory::+chord-qualities+)))
    (ok (equal qualities (mapcar #'first music-theory::+chord-print-words+)))
    (ok (equal *dialects* music-theory::+chord-print-dialects+))
    (loop for d in *dialects* for column from 1
          for words = (dialect-words d)
          do (dolist (row music-theory::+chord-print-words+)
               (let* ((cell (nth column row))
                      (quality (if (consp cell) (first cell) (first row)))
                      (word (if (consp cell)
                                (nth column (assoc quality music-theory::+chord-print-words+))
                                cell)))
                 (ok (stringp word) (format nil "~A ~A prints a word" d (first row)))
                 (when (consp cell)
                   (ok (member (list quality (second cell) (first row))
                               music-theory::+fifth-alteration-folds+ :test #'equal)
                       (format nil "~A ~A unfolds to what the parser folds" d (first row))))
                 (ok (if (seventh-quality-p quality)
                         (member word (cdr (assoc quality music-theory::+chord-seventh-stems+))
                                 :test #'string=)
                         (equal (list quality nil nil)
                                (rest (find word words :key #'first :test #'string=))))
                     (format nil "~A reads ~S back as ~A" d word quality)))))
    (ok (every (lambda (row)
                 (destructuring-bind (dialects quality extensions word alterations added omitted) row
                   (declare (ignore alterations omitted))
                   (every (lambda (d)
                            (or (string= word "7alt")
                                (equal (list quality extensions added)
                                       (rest (find word (dialect-words d) :key #'first
                                                                          :test #'string=)))))
                          dialects)))
               music-theory::+chord-print-specials+)
        "special words read back")))

(deftest musicxml-kind-table
  (let ((rows music-theory::+musicxml-kinds+))
    (ok (equal *musicxml-kinds* (mapcar #'first rows)))
    (ok (every (lambda (row) (typep (second row) '(or null string))) rows))
    (ok (null (second (assoc "other" rows :test #'string=))))
    (ok (every (lambda (q) (or (null (second q)) (assoc (second q) rows :test #'string=)))
               music-theory::+chord-qualities+)
        "every MusicXML kind of +chord-qualities+ has a row")))

(deftest chord-tone-priority-table
  (let* ((rows music-theory::+chord-tone-priorities+)
         (keys (loop for (q) in music-theory::+chord-qualities+
                     nconc (if (seventh-quality-p q)
                               (mapcar (lambda (e) (cons q e)) '(() (9) (9 11) (9 11 13)))
                               (list (list q)))))
         (major-third '(:dominant-7 :major-7 :augmented-7 :augmented-major-7)))
    (ok (= 39 (length rows)))
    (ok (null (set-exclusive-or keys (mapcar #'car rows) :test #'equal)) "one row per quality and extensions")
    (dolist (row rows)
      (destructuring-bind ((quality . extensions) . entries) row
        (let* ((degrees (remove :colour entries))
               (natural (append '(1) (quality-degrees quality) extensions))
               (left-out (cond ((and (member quality major-third) (equal extensions '(9 11))) '(3))
                               ((and (member quality major-third) (equal extensions '(9 11 13))) '(11)))))
          (ok (= 1 (count :colour entries)) (format nil "~S: one :colour" (car row)))
          (ok (= (length degrees) (length (remove-duplicates degrees))) (format nil "~S: no repeats" (car row)))
          (ok (null (set-exclusive-or degrees (set-difference natural left-out)))
              (format nil "~S lists its tones but ~S" (car row) left-out)))))
    (ok (equal '(3 7 13 :colour 1 9 5) (cdr (assoc '(:dominant-7 9 11 13) rows :test #'equal)))
        "dominant 13: 3, 7, 13, then root, 9, 5; 11 is omitted")))

;;; Fixtures -------------------------------------------------------------------

(deftest symbol-fixtures
  ;; Each row in each dialect it applies to: root, bass, and the set of tones
  ;; against music21's realisation of the row's recipe.
  (let* ((cases (symbol-fixture-cases))
         (bad (collect-mismatches (case cases)
                (destructuring-bind ((text dialect root bass &rest more) d) case
                  (declare (ignore dialect more))
                  (let ((c (cp text d)))
                    (and (equalp (and root (pc root)) (chord-symbol-root c))
                         (equalp (and bass (pc bass)) (chord-symbol-bass c))
                         (eq (null root) (chord-symbol-no-chord-p c)))))
                (destructuring-bind ((text dialect root bass tones &rest more) d) case
                  (declare (ignore dialect root bass more))
                  (same-set-p tones (class-names (chord-tones (cp text d)))))
                (destructuring-bind ((text &rest more) d) case
                  (declare (ignore more))
                  (let ((c (cp text d)))
                    (and (equal text (chord-symbol-text c)) (eq d (chord-symbol-dialect c))))))))
    (ok (= 347 (length (fixture "mt3-symbols.sexp"))))
    (ok (= 981 (length cases)))
    (ok (null bad) (report bad))))

(deftest symbol-fixture-degrees
  ;; Every tone lies its degree's letter distance above the root (9 → 2nd letter).
  (let ((bad (collect-mismatches (case (symbol-fixture-cases))
               (destructuring-bind ((text &rest more) d) case
                 (declare (ignore more))
                 (let ((c (cp text d)))
                   (every (lambda (tone)
                            (= (mod (1- (car tone)) 7)
                               (mod (- (pitch-class-name-letter (cdr tone))
                                       (pitch-class-name-letter (chord-symbol-root c)))
                                    7)))
                          (chord-tones c)))))))
    (ok (null bad) (report bad))))

(deftest musicxml-kind-fixtures
  ;; Our text on C, transposed to music21's root, realises music21's kind.
  (let* ((rows (fixture "mt3-kinds.sexp"))
         (bad (collect-mismatches (row (remove :same rows :key #'fifth :test-not #'eq))
                (destructuring-bind (kind text root tones status) row
                  (declare (ignore kind status))
                  (let ((c (cp text)))
                    (if (chord-symbol-no-chord-p c)
                        (and (null root) (null tones) (null (chord-tones c)))
                        (let ((moved (transpose-chord-symbol
                                      c (interval-between (parse-pitch "C4")
                                                          (parse-pitch (format nil "~A4" root))))))
                          (and (equalp (pc root) (chord-symbol-root moved))
                               (same-set-p tones (class-names (chord-tones moved)))))))))))
    (ok (= 157 (length rows)))
    (ok (null bad) (report bad))
    (ok (equal '("Neapolitan") (remove-duplicates (mapcar #'first (remove :differs rows :key #'fifth
                                                                                       :test-not #'eq))
                                                  :test #'string=)))
    (let ((neapolitan (find "Neapolitan" rows :key #'first :test #'string=)))
      (ok (not (same-set-p (fourth neapolitan) (class-names (chord-tones (cp (second neapolitan))))))
          "music21's Neapolitan type is not the major triad")
      (ok (equal '((1 . "C") (3 . "E") (5 . "G")) (tone-names (chord-tones (cp (second neapolitan)))))))))

(deftest musicxml-kind-texts
  (dolist (row music-theory::+musicxml-kinds+)
    (destructuring-bind (kind text) row
      (when text
        (ok (string= text (print-chord-symbol (cp text))) (format nil "~A: ~S is canonical" kind text)))))
  (dolist (q music-theory::+chord-qualities+)
    (when (second q)
      (ok (same-chord-p (ch :root "C" :quality (first q))
                        (cp (second (assoc (second q) music-theory::+musicxml-kinds+ :test #'string=))))
          (format nil "kind ~A is the quality ~A" (second q) (first q)))))
  (ok (chord-symbol-no-chord-p (cp (second (assoc "none" music-theory::+musicxml-kinds+ :test #'string=))))))

(deftest transpose-fixtures
  (let* ((rows (fixture "mt3-transpose.sexp"))
         (bad (collect-mismatches (row rows)
                (destructuring-bind (text by root bass tones status) row
                  (let* ((how (if (stringp by) (parse-interval by) (mapcar #'k by)))
                         (moved (ignore-errors (transpose-chord-symbol (cp text) how))))
                    (ecase status
                      (:ok (and (equalp (pc root) (chord-symbol-root moved))
                                (equalp (and bass (pc bass)) (chord-symbol-bass moved))
                                (same-set-p tones (class-names (chord-tones moved)))))
                      (:root-out-of-range
                       (signals-type (lambda () (transpose-chord-symbol (cp text) how)) 'invalid-pitch))
                      (:tones-out-of-range
                       (and moved (signals-type (lambda () (chord-tones moved)) 'invalid-pitch)))))))))
    (ok (= 256 (length rows)))
    (ok (null bad) (report bad))))

;;; Round trips ----------------------------------------------------------------

(defun round-trip-failures (values)
  "Values whose print → parse in some dialect and style is not the value again,
or whose second printing differs from the first."
  (loop for c in values
        nconc (loop for d in *dialects*
                    nconc (loop for a in '(:ascii :unicode)
                                for text = (ignore-errors (print-chord-symbol c :dialect d :accidentals a))
                                for back = (and text (ignore-errors (parse-chord-symbol text :dialect d)))
                                unless (and back (same-chord-p c back) (eq d (chord-symbol-dialect back))
                                            (equal text (print-chord-symbol back :dialect d :accidentals a)))
                                  collect (list c d a text)))))

(deftest round-trip-fixture-symbols
  (let ((bad (round-trip-failures
              (mapcar (lambda (case) (cp (first (first case)) (second case))) (symbol-fixture-cases)))))
    (ok (null bad) (report bad))))

(deftest round-trip-generated-values
  ;; Every quality and extensions, three alteration sets, with and without a bass.
  (let ((values (loop for row in music-theory::+chord-tone-priorities+
                      for (quality . extensions) = (car row)
                      nconc (loop for alterations in '(() ((9 . -1)) ((11 . 1) (13 . -1)))
                                  nconc (loop for bass in '(nil "F#")
                                              collect (ch :root "Bb" :quality quality :extensions extensions
                                                          :alterations alterations :bass bass))))))
    (ok (= (* 39 3 2) (length values)))
    (ok (null (round-trip-failures values)) (report (round-trip-failures values)))))

